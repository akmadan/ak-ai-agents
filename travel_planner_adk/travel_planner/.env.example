GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
TAVILY_API_KEY=
AGENT_MODEL=gemini-flash-latest
PLACE_IMAGE_BASE_URL=
CORS_ORIGINS=*

# MCP server (mcp_server.py). Defaults: streamable HTTP on 0.0.0.0:8002 at /mcp.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8002
# MCP_PATH=/mcp

# A2A server (a2a_app.py). Defaults: listen on 0.0.0.0:8001, card at http://localhost:8001.
# A2A_BIND_HOST=0.0.0.0
# A2A_PORT=8001
# A2A_HOST=localhost
# A2A_PUBLIC_PORT=8001
# A2A_PROTOCOL=http
