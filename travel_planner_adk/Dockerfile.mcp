FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    GOOGLE_GENAI_USE_VERTEXAI=FALSE \
    MCP_TRANSPORT=streamable-http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000 \
    MCP_PATH=/mcp

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY mcp_server.py ./
COPY travel_planner ./travel_planner

ENV PATH="/app/.venv/bin:$PATH"

# AgentCore Runtime expects MCP on 0.0.0.0:8000/mcp.
# Build for ARM64: docker buildx build --platform linux/arm64 -f Dockerfile.mcp ...
# Keys are not baked in. Set GOOGLE_API_KEY and TAVILY_API_KEY at run time.
EXPOSE 8000

CMD ["python", "mcp_server.py"]
